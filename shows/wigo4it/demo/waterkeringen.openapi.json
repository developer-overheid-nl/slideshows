{
  "openapi": "3.0.3",
  "info": {
    "title": "Waterkeringen API",
    "description": "Raadpleeg waterkeringen volgens het Aquo-begrippenkader / IMWA Waterveiligheid.",
    "version": "1.0.0",
    "contact": {
      "name": "Team Waterkeringen",
      "email": "api@example.nl",
      "url": "https://example.nl/waterkeringen"
    }
  },
  "servers": [
    {
      "url": "https://api.example.nl/waterkeringen"
    }
  ],
  "paths": {
    "/waterKeringen": {
      "get": {
        "operationId": "listWaterkeringen",
        "summary": "Lijst van waterkeringen",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter op Aquo-waterkeringtype.",
            "schema": {
              "$ref": "#/components/schemas/WaterkeringType"
            }
          },
          {
            "name": "categorie",
            "in": "query",
            "description": "Filter op Aquo-waterkeringcategorie.",
            "schema": {
              "$ref": "#/components/schemas/WaterkeringCategorie"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/API-Version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Waterkering"
                  }
                }
              }
            }
          }
        },
        "description": "Haalt een lijst van waterkeringen op, optioneel gefilterd op type en categorie.",
        "tags": [
          "Waterkeringen"
        ]
      }
    },
    "/waterKeringen/{id}": {
      "get": {
        "operationId": "getWaterkering",
        "summary": "Eén waterkering ophalen",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unieke identificatie van de waterkering.",
            "schema": {
              "type": "string",
              "example": "WK-0001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Waterkering"
                }
              }
            }
          },
          "404": {
            "description": "Waterkering niet gevonden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Not found"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Haalt één waterkering op aan de hand van de identificatie.",
        "tags": [
          "Waterkeringen"
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "OpenAPI-specificatie",
        "description": "Geeft de OpenAPI-specificatie van deze API terug.",
        "tags": [
          "Documentatie"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/API-Version"
              },
              "access-control-allow-origin": {
                "description": "CORS: specificatie is voor iedereen leesbaar.",
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "API-Version": {
        "description": "Volledige versie van de API.",
        "schema": {
          "type": "string",
          "example": "1.0.0"
        }
      }
    },
    "schemas": {
      "Waterkering": {
        "type": "object",
        "description": "Kunstmatige hoogte, natuurlijke hoogte of gedeelte daarvan, of hoge gronden met ondersteunende kunstwerken, die een waterkerende of mede een waterkerende functie hebben.",
        "required": [
          "id",
          "type",
          "categorie"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "WK-0001"
          },
          "naam": {
            "type": "string",
            "example": "Lekdijk"
          },
          "type": {
            "$ref": "#/components/schemas/WaterkeringType"
          },
          "categorie": {
            "$ref": "#/components/schemas/WaterkeringCategorie"
          },
          "geometrie": {
            "$ref": "#/components/schemas/LineString"
          }
        }
      },
      "WaterkeringType": {
        "type": "string",
        "description": "Aquo-domeintabel 'Waterkeringtype'.",
        "enum": [
          "Dam",
          "Dijk",
          "Duin",
          "Flexibele waterkering",
          "Hoge gronden",
          "Kistdam",
          "Kunstwerk",
          "Wandconstructie"
        ],
        "example": "Dijk"
      },
      "WaterkeringCategorie": {
        "type": "string",
        "description": "Aquo-domeintabel 'WaterkeringCategorie'.",
        "enum": [
          "Primaire waterkering",
          "Regionale waterkering",
          "Boezemkade",
          "Kering langs regionale rivieren en kanalen",
          "Overige waterkering"
        ],
        "example": "Primaire waterkering"
      },
      "LineString": {
        "type": "object",
        "description": "Hartlijn van de waterkering, als GeoJSON LineString (WGS84).",
        "required": [
          "type",
          "coordinates"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LineString"
            ]
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "example": [
              [
                4.98,
                51.95
              ],
              [
                5.02,
                51.96
              ],
              [
                5.06,
                51.965
              ]
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Waterkeringen",
      "description": "Waterkeringen uit het Aquo-begrippenkader."
    },
    {
      "name": "Documentatie",
      "description": "API-documentatie."
    }
  ]
}

{
  "name": "marp-cli-example",
  "version": "0.0.0",
  "author": "Yuki Hattori <yukihattori1116@gmail.com>",
  "license": "WTFPL",
  "private": true,
  "scripts": {
    "build": "rimraf public && npm run -s deck && node scripts/index.mjs",
    "deck": "mkdir -p public && ncp ./shows public/shows && cpx \"./themes/**/!(*.keep|*.css)\" public/themes && marp --no-stdin --html -I ./shows -o public/shows && npm run -s deck:own-config",
    "deck:own-config": "find shows -name marp.config.mjs -exec sh -c 'marp --no-stdin --html -c \"$0\" \"${0%/*}/index.md\" -o \"public/${0%/*}/index.html\"' {} \\;",
    "start": "marp -s --html .",
    "pdf": "marp --pdf --browser-path chromium ./index.md --allow-local-files --theme ../../themes/don_main.css",
    "pptx": "marp --pptx --browser-path chromium ./index.md --allow-local-files --theme ../../themes/don_main.css",
    "odf": "marp --odf --browser-path chromium ./index.md --allow-local-files --theme ../../themes/don_main.css"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.2.3",
    "cpx": "^1.5.0",
    "ncp": "^2.0.0",
    "rimraf": "^6.0.1"  
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
